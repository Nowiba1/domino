<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff6b6b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ee5a24;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="tileBody" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f0e6d3;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="tileBody2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#fffdf7;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f5e6c8;stop-opacity:1" />
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000" flood-opacity="0.35"/>
    </filter>
    <filter id="bounce">
      <feDropShadow dx="0" dy="2.5" stdDeviation="3" flood-color="#8b1e1e" flood-opacity="0.5"/>
    </filter>
    <radialGradient id="dotGrad" cx="40%" cy="35%">
      <stop offset="0%" style="stop-color:#2c3e50;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d1117;stop-opacity:1" />
    </radialGradient>
    <radialGradient id="dotGradAccent" cx="40%" cy="35%">
      <stop offset="0%" style="stop-color:#e74c3c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#c0392b;stop-opacity:1" />
    </radialGradient>
  </defs>

  <!-- Fun rounded background -->
  <rect x="2" y="2" width="60" height="60" rx="16" ry="16" fill="url(#bgGrad)" stroke="#ffcc00" stroke-width="2.5"/>

  <!-- Googly eyes on the background for humor -->
  <!-- Left eye -->
  <circle cx="20" cy="14" r="5" fill="white" stroke="#333" stroke-width="1.2"/>
  <circle cx="18" cy="14" r="2.5" fill="#111"/>
  <circle cx="17" cy="13" r="0.8" fill="white"/>

  <!-- Right eye -->
  <circle cx="44" cy="14" r="5" fill="white" stroke="#333" stroke-width="1.2"/>
  <circle cx="46" cy="15" r="2.5" fill="#111"/>
  <circle cx="47" cy="14" r="0.8" fill="white"/>

  <!-- Smile -->
  <path d="M26 22 Q32 29 38 22" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round"/>

  <!-- Tile 1: 6|6 with playful tilt -->
  <g filter="url(#shadow)" transform="rotate(-8, 32, 40)">
    <rect x="8" y="34" width="26" height="13" rx="3" ry="3" fill="url(#tileBody)" stroke="#d4a843" stroke-width="1.5"/>
    <line x1="21" y1="34" x2="21" y2="47" stroke="#d4a843" stroke-width="1.5"/>
    <!-- Left: 6 pips -->
    <circle cx="13" cy="37" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="13" cy="40.5" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="13" cy="44" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="18" cy="37" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="18" cy="40.5" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="18" cy="44" r="1.4" fill="url(#dotGrad)"/>
    <!-- Right: 6 pips -->
    <circle cx="24" cy="37" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="24" cy="40.5" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="24" cy="44" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="29" cy="37" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="29" cy="40.5" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="29" cy="44" r="1.4" fill="url(#dotGrad)"/>
  </g>

  <!-- Tile 2: 3|5 with opposite tilt -->
  <g filter="url(#shadow)" transform="rotate(12, 44, 52)">
    <rect x="30" y="48" width="24" height="12" rx="2.8" ry="2.8" fill="url(#tileBody2)" stroke="#d4a843" stroke-width="1.5"/>
    <line x1="42" y1="48" x2="42" y2="60" stroke="#d4a843" stroke-width="1.5"/>
    <!-- Left: 3 pips (diagonal, accented red) -->
    <circle cx="34.5" cy="51" r="1.4" fill="url(#dotGradAccent)"/>
    <circle cx="38.5" cy="54" r="1.4" fill="url(#dotGradAccent)"/>
    <circle cx="34.5" cy="57" r="1.4" fill="url(#dotGradAccent)"/>
    <!-- Right: 5 pips (quincunx) -->
    <circle cx="45.5" cy="51" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="51.5" cy="51" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="48.5" cy="54" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="45.5" cy="57" r="1.4" fill="url(#dotGrad)"/>
    <circle cx="51.5" cy="57" r="1.4" fill="url(#dotGrad)"/>
  </g>

  <!-- Party sparkles -->
  <text x="6" y="11" font-size="6">✨</text>
  <text x="52" y="8" font-size="5">⭐</text>
  <circle cx="56" cy="30" r="1.5" fill="#ffed4a" opacity="0.9"/>
</svg>